{
  "compilerOptions": {
    /* Target & Environment */
    "target": "ES2022" /* Specify ECMAScript target version */,
    "module": "NodeNext" /* Specify module code generation */,
    "moduleResolution": "NodeNext" /* Determine how modules get resolved */,
    "lib": ["ES2022"] /* Specify library files to be included */,

    /* Directories */
    "rootDir": "./src" /* Specify the root directory of input files */,
    "outDir": "./dist" /* Redirect output structure to the directory */,

    /* Strictness & Compliance */
    "strict": true /* Enable all strict type-checking options */,
    "noImplicitAny": true /* Raise error on expressions and declarations with an implied 'any' type */,
    "strictNullChecks": true /* Enable strict null checks */,

    /* Interoperability & Optimization */
    "esModuleInterop": true /* Enables emit interoperability between CommonJS and ES Modules */,
    "forceConsistentCasingInFileNames": true /* Disallow inconsistently-cased references to the same file */,
    "skipLibCheck": true /* Skip type checking of declaration files (.d.ts) */,
    "types": ["node"],

    /* Advanced Options */
    "sourceMap": true /* Create source map files for emitted JavaScript files */,
    "resolveJsonModule": true /* Include modules imported with '.json' extension */
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist"
  ] /* Exclude dependencies and build outputs */
}
