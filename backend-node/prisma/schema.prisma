// Prisma schema — https://pris.ly/d/prisma-schema
// The database URL lives in prisma.config.ts (Prisma 7 no longer reads it from here).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // The backend compiles to CommonJS, so the generated client must too.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  links        Link[]

  @@map("users")
}

model Link {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  originalUrl String    @map("original_url")
  title       String?
  isActive    Boolean   @default(true) @map("is_active")
  // Null means the link never expires. After this moment GET /:code answers 410.
  expiresAt   DateTime? @map("expires_at")
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // The dashboard lists a user's links newest first; this index serves exactly that query.
  @@index([userId, createdAt(sort: Desc)])
  @@map("links")
}
