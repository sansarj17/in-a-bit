# Copy to .env.local and adjust:  cp .env.example .env.local

# Express API that /api/* is forwarded to (see next.config.ts).
# Required for production builds — set it in the Vercel project's environment variables.
BACKEND_URL=http://localhost:8080

# Origin lock: added to every request forwarded to the API (see src/proxy.ts); must match the
# API's PROXY_SECRET. Leave empty locally. Required for production builds.
PROXY_SECRET=
