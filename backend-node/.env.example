# Copy to .env and adjust:  cp .env.example .env

NODE_ENV=development
PORT=8080
# fatal | error | warn | info | debug | trace | silent
DEFAULT_LOG_LEVEL=info

# Matches docker-compose.yml at the repo root (docker compose up -d)
DATABASE_URL="postgresql://inabit:inabit@localhost:5433/in_a_bit"

# Signs login tokens. Required, at least 32 characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# Public URL of the frontend (short links are served from it)
APP_URL=http://localhost:3000

# Proxies in front of the API: 1 locally (the Next.js dev server). In production it is
# Vercel plus your API host's load balancer, usually 2. Used to find the client IP.
TRUST_PROXY_HOPS=1

# Origin lock: the API only accepts requests carrying this secret, which the frontend's proxy
# adds. Leave empty locally (lock off). Required in production, with the same value set on the
# frontend. Generate with: openssl rand -base64 48
PROXY_SECRET=
