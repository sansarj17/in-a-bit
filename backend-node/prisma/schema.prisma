// Prisma schema — https://pris.ly/d/prisma-schema
// The database URL lives in prisma.config.ts (Prisma 7 no longer reads it from here).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // The backend compiles to CommonJS, so the generated client must too.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}
