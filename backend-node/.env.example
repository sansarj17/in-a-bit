# Copy to .env and adjust:  cp .env.example .env

NODE_ENV=development
PORT=8080
# fatal | error | warn | info | debug | trace | silent
DEFAULT_LOG_LEVEL=info

# Matches docker-compose.yml at the repo root (docker compose up -d)
DATABASE_URL="postgresql://inabit:inabit@localhost:5433/in_a_bit"

# Signs login tokens. Required, at least 32 characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=
